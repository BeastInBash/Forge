{
  "expo": {
    "name": "Forge",
    "slug": "Forge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "forge",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "in.besaif.forge.fitness",
      "icon": {
        "light": "./assets/images/icon-light.png",
        "dark": "./assets/images/icon.png"
      }
    },
    "android": {
      "package": "in.besaif.forge.fitness",
      "adaptiveIcon": {
        "backgroundColor": "#15181C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ECEEF1",
          "image": "./assets/images/logo-light.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#15181C",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Forge uses your photos to add images to exercises.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
